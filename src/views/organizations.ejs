<%- include('partials/header') %>
<main>
    <div class="page-heading">
        <h1><%= title %></h1> 

        <% if (user && user.role_name === 'admin') { %>
            <a class="create-action" href="/new-organization">
                <span class="create-action-icon create-action-icon--organization" aria-hidden="true"></span>
                <span>Add organization</span>
            </a>
        <% } %>
    </div>

    <p>Here are a few of our partner organizations:</p>
    <ul class="organization-list">
        <% organizations.forEach((organization) => { %>
            <li><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.orgname %> logo"><a class="org-link" href="/organization/<%= organization.organization_id %>"><%= organization.orgname %></a> <%= organization.contact_email %></li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>  