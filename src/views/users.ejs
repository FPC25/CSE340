<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2>Users</h2>
    <div class="table-wrapper">
        <table class="users-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>E-mail/Username</th>
                    <th>Role</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                    <tr>
                        <td><%= user.name %></td>
                        <td><%= user.email %></td>
                        <td><%= user.role_name %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</main>
<%- include('partials/footer') %>