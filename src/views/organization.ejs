<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <div class="organization-heading">
        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.orgname %> logo">
        <h2><%= organizationDetails.orgname %></h2>
    </div>

    <p>Description: <%= organizationDetails.description %></p>
    <p>Contact Email: <%= organizationDetails.contact_email %></p>

    <h3>Projects</h3>
    <ul class="project-list">
        <% projects.forEach((project) => { %>
            <li>
                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %> 