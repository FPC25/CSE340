<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">View Users</a></p>
    <% } %>

    <div class="projects-heading">
        <h3>Projects</h3>
        <% if (Array.isArray(projects) && projects.length > 0) { %>
            <div class="project-view-controls" role="group" aria-label="Project view">
                <button
                    type="button"
                    data-project-view="cards"
                    aria-label="Cards view"
                    title="Cards view"
                    aria-pressed="true">
                    <img src="/images/grid.svg" alt="" aria-hidden="true">
                </button>
                <button
                    type="button"
                    data-project-view="list"
                    aria-label="List view"
                    title="List view"
                    aria-pressed="false">
                    <img src="/images/list-check.svg" alt="" aria-hidden="true">
                </button>
            </div>
        <% } %>
    </div>

    <% if (Array.isArray(projects) && projects.length > 0) { %>
        <section data-project-panel="cards">
            <ul class="volunteer-projects">
                <% projects.forEach((project) => { %>
                    <li>
                        <div class="volunteer-project-heading">
                            <h4>
                                <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                            </h4>
                            <form
                                class="volunteer-removal-form"
                                action="/project/<%= project.project_id %>/remove-volunteer"
                                method="POST">
                                <input type="hidden" name="returnTo" value="dashboard">
                                <button
                                    class="volunteer-remove-button"
                                    type="submit"
                                    aria-label="Remove me from <%= project.title %>"
                                    title="Remove me from this project">
                                    <span class="volunteer-remove-icon" aria-hidden="true"></span>
                                </button>
                            </form>
                        </div>

                        <p><strong>Date:</strong> <%= formatDate(project.date) %></p>
                        <p><strong>Location:</strong> <%= project.location %></p>
                    </li>
                <% }); %>
            </ul>
        </section>

        <section data-project-panel="list" hidden>
            <div class="table-wrapper">
                <table class="users-table">
                    <thead>
                        <tr>
                            <th>Project</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Remove me</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% projects.forEach((project) => { %>
                            <tr>
                                <td>
                                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                                </td>
                                <td><%= formatDate(project.date) %></td>
                                <td><%= project.location %></td>
                                <td>
                                    <form
                                        class="volunteer-removal-form"
                                        action="/project/<%= project.project_id %>/remove-volunteer"
                                        method="POST">
                                        <input type="hidden" name="returnTo" value="dashboard">
                                        <button
                                            class="volunteer-remove-button"
                                            type="submit"
                                            aria-label="Remove me from <%= project.title %>"
                                            title="Remove me from this project">
                                            <span class="volunteer-remove-icon" aria-hidden="true"></span>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>
    <% } else { %>
        <p>No projects volunteered for yet.</p>
    <% } %>

</main>
<%- include('partials/footer') %>