<%- include('partials/header') %>
<main>
    <div class="page-heading">
        <h1><%= title %></h1>

        <% if (user && user.role_name === 'admin') { %>
            <a class="create-action" href="/new-category">
                <span
                    class="create-action-icon create-action-icon--category"
                    aria-hidden="true"></span>
                <span>New category</span>
            </a>
        <% } %>
    </div>

    <ul> 
        <% categories.forEach((category) => { %>
            <li><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>