<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

 <form action="/new-organization" method="POST">
    <%- include('partials/required-fields-note') %>
    <div class="form-group">
      <label for="name">Organization Name <span class="required-indicator" aria-hidden="true">*</span></label>
      <input
        type="text"
        id="name"
        name="name"
        maxlength="150"
        required
      />
    </div>

    <div class="form-group">
      <label for="description">Description <span class="required-indicator" aria-hidden="true">*</span></label>
      <textarea
        id="description"
        name="description"
        maxlength="500"
        required
      ></textarea>
    </div>

    <div class="form-group">
      <label for="contactEmail">Contact Email <span class="required-indicator" aria-hidden="true">*</span></label>
      <input
        type="email"
        id="contactEmail"
        name="contactEmail"
        required
      />
    </div>

    <button type="submit">Create Organization</button>
  </form>

</main>
<%- include('partials/footer') %>