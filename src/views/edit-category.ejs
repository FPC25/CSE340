<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-category/<%= categoryDetails.category_id %>" method="POST">
        <%- include('partials/required-fields-note') %>
        <div class="form-group">
            <label for="categoryName">Category Name <span class="required-indicator" aria-hidden="true">*</span></label>
            <input
                type="text"
                id="categoryName"
                name="category_name"
                value="<%= categoryDetails.category_name %>"
                maxlength="100"
                required
            >
        </div>

        <button type="submit">Update Category</button>
    </form>

</main>
<%- include('partials/footer') %>