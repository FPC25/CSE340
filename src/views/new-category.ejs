<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/new-category" method="POST">
        <%- include('partials/required-fields-note') %>
        <div class="form-group">
            <label for="categoryName">Category Name <span class="required-indicator" aria-hidden="true">*</span></label>
            <input
                type="text"
                id="categoryName"
                name="category_name"
                required
                maxlength="100"
            >
        </div>

        <button type="submit">Create Category</button>
    </form>

</main>
<%- include('partials/footer') %>