<%- include('partials/header') %>
<main>
    <div class="page-heading">
        <h1><%= title %></h1>

        <% if (user && user.role_name === 'admin') { %>
            <a class="create-action" href="/new-project">
                <span
                    class="create-action-icon create-action-icon--project"
                    aria-hidden="true"></span>
                <span>New project</span>
            </a>
        <% } %>
    </div>
     
    <h2>Upcoming Service Projects</h2>
    <ul class="project-list">
        <% projects.forEach((project) => { %>
            <li>
                <h3><%= formatDate(project.date) %>: <a href="/project/<%= project.project_id %>"><%= project.title %></a> (<a class="org-link" href="/organization/<%= project.organization_id %>"><%= project.orgname %></a>)</h3>
                <p><strong>Location:</strong> <%= project.location %></p>
                <p><%= project.description %></p>
            </li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>