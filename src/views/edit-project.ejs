<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
        <div class="form-group">
            <label for="organization">Organization</label>
            <select id="organization" name="organization_id" required>
                <option value="">Select an organization</option>
                <% allOrganizations.forEach(organization => { %>
                    <option
                        value="<%= organization.organization_id %>"
                        <%= organization.organization_id === projectDetails.organization_id ? 'selected' : '' %>
                    >
                        <%= organization.orgname %>
                    </option>
                <% }) %>
            </select>
        </div>


        <div class="form-group">
            <label for="title">Project title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= projectDetails.title %>"
                maxlength="150"
                required
            />
        </div>

        <div class="form-group">
            <label for="description">Project Description</label>
            <textarea
                id="description"
                name="description"
                maxlength="500"
                required
            >
                <%= projectDetails.description %>
            </textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                maxlength="255"
                value="<%= projectDetails.location%>"
                required
            >
        </div>
        
        <div class="form-group">
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                value="<%= formatDateInput(projectDetails.date) %>"
                required
            >
        </div>

        <button type="submit">Update Project</button>
    </form>

</main>
<%- include('partials/footer') %>